// Waybar config: Halo CE HUD strip. Translucent bar (frosted by a layer rule in hypr/theme.lua),
// framed panels with a soft blue glow, slanted segment meters. Labels: menu blue, values near-white.
// Docs: man 5 waybar, and man waybar-<module> (e.g. man waybar-battery)
{
    "layer": "top",
    "position": "top",
    "height": 28,      // room for the framed panels (3 px margin + 1 px frame + glow)
    "spacing": 0,

    // Panels: every group below is one framed Halo CE panel in style.css (#workspaces, #clock, #systems, #health)
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/systems", "group/health", "tray"],

    "group/systems": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "backlight", "network"]
    },
    "group/health": {
        "orientation": "horizontal",
        "modules": ["battery#icon", "battery#h1", "battery#h2", "battery#h3", "battery#h4", "battery#h5", "battery#h6", "battery#h7", "battery#h8", "battery#h9", "battery#h10", "battery#pct"]
    },

    "hyprland/workspaces": {
        "format": "{id}"
    },
    // Clock = the menu title: blue date, near-white time
    "clock": {
        "format": "<span color='#4da3ff'>{0:%a %d %b}</span>   {0:%H:%M}",   // two fields = explicit index 0
        "tooltip-format": "{calendar}"
    },
    // Meters: tall blocks (U+25AE) slanted by Pango (style oblique), like the health tiles.
    // {icon} picks one of the format-icons by level; lit #4aaaff, unlit #17345f.
    "pulseaudio": {
        "format": "<span color='#4da3ff'>VOL</span> {icon}",
        "format-muted": "<span color='#4da3ff'>VOL</span> <span color='#ff8f80'>MUTE</span>",
        "format-icons": ["<span color='#4aaaff'></span><span color='#17345f'>▮▮▮▮▮</span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮</span><span color='#17345f'>▮▮▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮</span><span color='#17345f'>▮▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮</span><span color='#17345f'>▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮▮</span><span color='#17345f'>▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮▮▮</span></span>"],
        "tooltip-format": "Volume {volume}% on {desc}\nClick: mixer (wiremix)",
        "on-click": "kitty --class wiremix wiremix"   // PipeWire mixer TUI, colors from ~/.config/wiremix
    },
    "backlight": {
        "format": "<span color='#4da3ff'>󰃟</span> {icon}",   // Nerd Font: brightness (U+F00DF)
        "format-icons": ["<span color='#4aaaff'></span><span color='#17345f'>▮▮▮▮▮</span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮</span><span color='#17345f'>▮▮▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮</span><span color='#17345f'>▮▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮</span><span color='#17345f'>▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮▮</span><span color='#17345f'>▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮▮▮</span></span>"],
        "tooltip-format": "Brightness {percent}%"
    },
    // Wi-Fi: signal strength only; the network name stays in the tooltip (keeps it out of screenshots)
    "network": {
        "format-wifi": "<span color='#4da3ff'>COMMS</span> {icon}",
        "format-ethernet": "<span color='#4da3ff'>COMMS</span> WIRED",
        "format-disconnected": "<span color='#4da3ff'>COMMS</span> <span color='#ff8f80'>DOWN</span>",
        "format-icons": ["<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮</span><span color='#17345f'>▮▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮</span><span color='#17345f'>▮▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮</span><span color='#17345f'>▮</span></span>", "<span font_family='JetBrainsMono Nerd Font' size='9pt' style='oblique' letter_spacing='1024'><span color='#4aaaff'>▮▮▮▮</span></span>"],
        "tooltip-format-wifi": "Wi-Fi {essid}, signal {signalStrength}%\nLeft-click: saved connections · Right-click: join Wi-Fi",
        "tooltip-format": "{ifname}\nLeft-click: saved connections · Right-click: join Wi-Fi",
        "on-click": "nm-connection-editor",      // saved connections (GTK3, themed)
        "on-click-right": "~/dotfiles/bin/comms"  // nmtui in theme colors: scan and join Wi-Fi
    },
    // Battery = several copies of the same module: cross | 10 health tiles | percentage.
    // "battery#icon" is styled in CSS as #battery.icon (same for .h1 ... .h10 and .pct).
    // Halo CE health HUD: cross icon + bar + number, all colored by state
    // (states pick the lowest threshold >= capacity: 14% -> red, 50% -> yellow, 80% -> blue)
    "battery#icon": {
        "format": " ",                // empty: the slanted cross is drawn in style.css
        "states": { "blue": 100, "yellow": 60, "red": 30 }
    },
    // Health tiles h1..h10 (10% each, h1 next to the cross, h10 on the right), drawn in style.css.
    // Like Halo CE, health drains from the LEFT: h10 stays lit longest, h1 goes first.
    // A tile is "off" (hidden but keeps its width, so the lit ones stay right-aligned) when
    // capacity <= its threshold; otherwise it gets the color state (red <= 30, yellow <= 60,
    // blue <= 100). Only color thresholds above the tile's own "off" threshold are listed,
    // because the lowest matching one wins.
    "battery#h1":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 90, "blue": 100 } },
    "battery#h2":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 80, "blue": 100 } },
    "battery#h3":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 70, "blue": 100 } },
    "battery#h4":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 60, "blue": 100 } },
    "battery#h5":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 50, "yellow": 60, "blue": 100 } },
    "battery#h6":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 40, "yellow": 60, "blue": 100 } },
    "battery#h7":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 30, "yellow": 60, "blue": 100 } },
    "battery#h8":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 20, "red": 30, "yellow": 60, "blue": 100 } },
    "battery#h9":  { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 10, "red": 30, "yellow": 60, "blue": 100 } },
    "battery#h10": { "format": " ", "tooltip-format": "Battery {capacity}%  {timeTo}",
                     "states": { "off": 0, "red": 30, "yellow": 60, "blue": 100 } },
    "battery#pct": {
        "format": "{capacity}%",
        "states": { "blue": 100, "yellow": 60, "red": 30 }
    },
    "tray": {
        "spacing": 8
    }
}
