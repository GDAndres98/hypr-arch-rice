# hyprlock TEMPLATE: Imperial control panel (after Ahren Hart's "Imperial Control Panel").
# Edit this .in file, then run `sw-mode` to rebuild hyprlock.conf.
# stack code = text + translation underneath, title code = same with the Oma Tres heading font. Codes: see sw-mode.
# @VAL@ = font for live values (date, typing), @BIG@ = font for the big clock (Aurebesh in modes 2 and 3).
# Docs: https://wiki.hypr.land/Hypr-Ecosystem/hyprlock
# Colors: rgba(RRGGBBAA). Positions: x,y from the anchor, y goes UP. Escape # in text as ##.
# Glow = shadow_* on a lit lamp. rounding = -1 makes a circle.
# Stacking is set by zindex (higher = on top): panel layers 1-3, lamps/text 10, dial hub + eye 12.
#
# Layout: one tall panel in the middle of the corridor wall (panel 460 x 600)
#   lamp row:  blue + unlit hexagon ........................ copper dial
#   lamp row:  white   white white red ..................... blinking red eye
#   title, rule, clock, date, password field
#   lamp row:  grey red red grey ........................... big white lamp

general {
    hide_cursor = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 3, linear
    animation = fadeOut, 1, 3, linear
    animation = inputFieldDots, 1, 2, linear
}

# Corridor wall
background {
    monitor =
    color = rgba(161719ff)
}

# --- The panel: gunmetal frame > navy-black face > thin worn trace outline ---
shape {
    monitor =
    zindex = 1
    size = 460, 600
    color = rgba(2e2f33ff)
    rounding = 4
    border_size = 2
    border_color = rgba(1c1d20ff)
    shadow_passes = 2
    shadow_size = 12
    shadow_color = rgba(00000099)
    position = 0, 0
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 2
    size = 428, 568
    color = rgba(0e1018ff)
    rounding = 2
    position = 0, 0
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 3
    size = 400, 540
    color = rgba(00000000)
    border_size = 1
    border_color = rgba(dcdcdc59)
    rounding = 0
    position = 0, 0
    halign = center
    valign = center
}

# --- Top lamp row: blue (lit) + unlit hexagon, copper dial ---
label {
    monitor =
    zindex = 10
    text = <span foreground="##4433ff">⬢</span>
    font_size = 30
    font_family = JetBrainsMono Nerd Font
    shadow_passes = 2
    shadow_size = 6
    shadow_color = rgba(4433ffcc)
    position = -150, 225
    halign = center
    valign = center
}
label {
    monitor =
    zindex = 10
    text = <span foreground="##3c3d40">⬢</span>
    font_size = 30
    font_family = JetBrainsMono Nerd Font
    position = -108, 225
    halign = center
    valign = center
}
# Dial ring
shape {
    monitor =
    zindex = 10
    size = 48, 48
    color = rgba(4a2214ff)
    rounding = -1
    border_size = 5
    border_color = rgba(9a4a2aff)
    position = 150, 225
    halign = center
    valign = center
}
# Dial hub
shape {
    monitor =
    zindex = 12
    size = 16, 16
    color = rgba(050506ff)
    rounding = -1
    border_size = 2
    border_color = rgba(6b3220ff)
    position = 150, 225
    halign = center
    valign = center
}

# --- Second lamp row: white, gap, white white red (all glowing) + blinking red eye ---
shape {
    monitor =
    zindex = 10
    size = 26, 26
    color = rgba(f2f2f2ff)
    rounding = 0
    shadow_passes = 2
    shadow_size = 7
    shadow_color = rgba(f2f2f2aa)
    position = -150, 170
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 26, 26
    color = rgba(f2f2f2ff)
    rounding = 0
    shadow_passes = 2
    shadow_size = 7
    shadow_color = rgba(f2f2f2aa)
    position = -100, 170
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 26, 26
    color = rgba(f2f2f2ff)
    rounding = 0
    shadow_passes = 2
    shadow_size = 7
    shadow_color = rgba(f2f2f2aa)
    position = -66, 170
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 26, 26
    color = rgba(ff2a2aff)
    rounding = 0
    shadow_passes = 2
    shadow_size = 7
    shadow_color = rgba(ff2a2acc)
    position = -32, 170
    halign = center
    valign = center
}
# The eye's dark housing
shape {
    monitor =
    zindex = 10
    size = 34, 34
    color = rgba(1c1d20ff)
    rounding = -1
    border_size = 2
    border_color = rgba(2e2f33ff)
    position = 150, 170
    halign = center
    valign = center
}
# The eye: blink.sh prints a lit or dark dot every second
label {
    monitor =
    zindex = 12
    text = cmd[update:1000] ~/dotfiles/current/hypr/blink.sh
    font_size = 13
    font_family = JetBrainsMono Nerd Font
    shadow_passes = 1
    shadow_size = 4
    shadow_color = rgba(ff2a2a99)
    position = 150, 170
    halign = center
    valign = center
}

# --- Title + translation ---
label {
    monitor =
    zindex = 10
    text = {{title:IMPERIAL SECURITY BUREAU}}
    color = rgba(ffffffff)
    font_size = 15
    font_family = @VAL@
    text_align = center
    position = 0, 105
    halign = center
    valign = center
}

# Thin trace across the panel
shape {
    monitor =
    zindex = 10
    size = 360, 1
    color = rgba(dcdcdc4d)
    rounding = 0
    position = 0, 68
    halign = center
    valign = center
}

# --- Clock and date ---
label {
    monitor =
    zindex = 10
    text = $TIME
    color = rgba(ffffffff)
    font_size = 60
    font_family = @BIG@
    shadow_passes = 1
    shadow_size = 6
    shadow_color = rgba(f2f2f255)
    position = 0, 10
    halign = center
    valign = center
}
label {
    monitor =
    zindex = 10
    text = cmd[update:60000] date +"%^A %d %^B %Y"
    color = rgba(8a8d93ff)
    font_size = 12
    font_family = @VAL@
    position = 0, -48
    halign = center
    valign = center
}

# --- Password field: a recessed slot; white while checking, red on a wrong code ---
input-field {
    monitor =
    zindex = 10
    size = 320, 44
    outline_thickness = 2
    rounding = 0
    inner_color = rgba(07080cff)
    outer_color = rgba(3c3d40ff)
    check_color = rgba(f2f2f2ff)
    fail_color  = rgba(ff2a2aff)
    font_color  = rgba(ffffffff)
    font_family = @VAL@
    fade_on_empty = false
    placeholder_text = <span foreground="##6b7078">AUTHORIZATION CODE</span>
    fail_text = <span foreground="##ff2a2a">ACCESS DENIED</span>
    dots_spacing = 0.4
    dots_rounding = 0
    position = 0, -110
    halign = center
    valign = center
}

# --- Bottom lamp row: grey red red grey (small), big white lamp ---
shape {
    monitor =
    zindex = 10
    size = 18, 18
    color = rgba(8a8d93ff)
    rounding = 0
    position = -150, -205
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 18, 18
    color = rgba(ff2a2aff)
    rounding = 0
    shadow_passes = 2
    shadow_size = 6
    shadow_color = rgba(ff2a2acc)
    position = -126, -205
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 18, 18
    color = rgba(ff2a2aff)
    rounding = 0
    shadow_passes = 2
    shadow_size = 6
    shadow_color = rgba(ff2a2acc)
    position = -102, -205
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 18, 18
    color = rgba(8a8d93ff)
    rounding = 0
    position = -78, -205
    halign = center
    valign = center
}
# Two little grey dots under the row
shape {
    monitor =
    zindex = 10
    size = 6, 6
    color = rgba(6a6b6eff)
    rounding = -1
    position = -138, -228
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 6, 6
    color = rgba(6a6b6eff)
    rounding = -1
    position = -126, -228
    halign = center
    valign = center
}
shape {
    monitor =
    zindex = 10
    size = 34, 34
    color = rgba(f2f2f2ff)
    rounding = 0
    shadow_passes = 2
    shadow_size = 8
    shadow_color = rgba(f2f2f2aa)
    position = 145, -210
    halign = center
    valign = center
}

# --- Outside the panel: restricted tag top-right, footer at the bottom ---
label {
    monitor =
    zindex = 10
    text = {{title:RESTRICTED}}
    color = rgba(ff2a2aff)
    font_size = 12
    font_family = @VAL@
    position = -40, -30
    halign = right
    valign = top
}
label {
    monitor =
    zindex = 10
    text = {{stack:TERMINAL LOCKED // PRESS ENTER}}
    color = rgba(6b7078ff)
    font_size = 10
    font_family = @VAL@
    text_align = center
    position = 0, 30
    halign = center
    valign = bottom
}
