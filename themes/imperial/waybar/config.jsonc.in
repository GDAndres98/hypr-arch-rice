// Waybar config TEMPLATE: Imperial wall panels. Edit this .in file, then run `sw-mode` to rebuild config.jsonc.
// pair code = label + translation (font order depends on the mode, see sw-mode). @VAL@ = font for live values.
// Numbers use @VAL@ (Aurebesh in modes 2 and 3); the tooltips (@BODY@) show them readable.
// Look: every module is a small Imperial control panel (gunmetal frame, glowing lamps), see style.css.in.
// Reference: Ahren Hart, "Imperial Control Panel" (ArtStation).
// LED meters ({icon}): lit squares have no color, so they take the module's CSS color
// (that's how the battery meter turns amber/red); unlit squares are dark grey spans.
// Docs: man 5 waybar, man waybar-<module>
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": ["custom/lamps", "custom/beacon", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "backlight", "network", "battery", "tray"],

    // Decoration only, copied from the panels: red + unlit hexagon, white and red squares, copper dial
    "custom/lamps": {
        "format": "<span font_family='JetBrainsMono Nerd Font'><span color='#ff2a2a'>⬢</span><span color='#3c3d40'>⬢</span>  <span color='#f2f2f2'>■</span> <span color='#f2f2f2'>■</span><span color='#ff2a2a'>■</span>  <span color='#9a4a2a'>◉</span></span>",
        "tooltip": false
    },
    // The red "eye" button that pulses (animation in style.css.in)
    "custom/beacon": {
        "format": "<span font_family='JetBrainsMono Nerd Font'>●</span>",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{id}"
    },
    "hyprland/window": {
        "format": "<span font_family='@BODY@'>{}</span>",
        "max-length": 50
    },
    // Center panel: the blue + unlit hexagon pair on each side of the time
    "clock": {
        "format": "<span font_family='JetBrainsMono Nerd Font'><span color='#4433ff'>⬢</span><span color='#3c3d40'>⬢</span></span>  <span foreground='#c9ccd1'>{{pair:SECTOR TIME}}</span>  <span font_family='@VAL@' foreground='#ffffff'>{:%H:%M}</span>  <span font_family='JetBrainsMono Nerd Font'><span color='#3c3d40'>⬢</span><span color='#4433ff'>⬢</span></span>",
        "tooltip-format": "{:%A %d %B %Y  %H:%M}"
    },
    "pulseaudio": {
        "format": "<span foreground='#c9ccd1'>{{pair:AUDIO}}</span> {icon} <span font_family='@VAL@' foreground='#ffffff'>{volume}%</span>",
        "format-muted": "<span foreground='#c9ccd1'>{{pair:AUDIO}}</span> <span font_family='@VAL@'>MUTED</span>",
        "format-icons": { "default": [
            "<span font_family='JetBrainsMono Nerd Font'><span color='#3c3d40'>■■■■■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■<span color='#3c3d40'>■■■■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■<span color='#3c3d40'>■■■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■■<span color='#3c3d40'>■■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■■■<span color='#3c3d40'>■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■■■■</span>"
        ] },
        "tooltip-format": "Volume {volume}%",
        "on-click": "pavucontrol"
    },
    "backlight": {
        "format": "<span foreground='#c9ccd1'>{{pair:LUMEN}}</span> {icon} <span font_family='@VAL@' foreground='#ffffff'>{percent}%</span>",
        "format-icons": [
            "<span font_family='JetBrainsMono Nerd Font'>■<span color='#3c3d40'>■■■■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■<span color='#3c3d40'>■■■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■■<span color='#3c3d40'>■■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■■■<span color='#3c3d40'>■</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>■■■■■</span>"
        ],
        "tooltip-format": "Brightness {percent}%"
    },
    "network": {
        "format-wifi": "<span foreground='#c9ccd1'>{{pair:COMMS}}</span> {icon} <span font_family='@VAL@' foreground='#ffffff'>{signalStrength}%</span>",
        "format-ethernet": "<span foreground='#c9ccd1'>{{pair:COMMS}}</span> <span font_family='@VAL@'>WIRED</span>",
        "format-disconnected": "<span foreground='#c9ccd1'>{{pair:COMMS}}</span> <span font_family='@VAL@'>DOWN</span>",
        "format-icons": [
            "<span font_family='JetBrainsMono Nerd Font'>●<span color='#3c3d40'>●●●</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>●●<span color='#3c3d40'>●●</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>●●●<span color='#3c3d40'>●</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>●●●●</span>"
        ],
        "tooltip-format": "{essid} {signalStrength}%  {ifname}"
    },
    // Battery: white cells, dimmer at 30%, red at 15% (CSS colors the lit cells)
    "battery": {
        "format": "<span foreground='#c9ccd1'>{{pair:POWER}}</span> {icon} <span font_family='@VAL@' foreground='#ffffff'>{capacity}%</span>",
        "format-charging": "<span foreground='#c9ccd1'>{{pair:POWER}}</span> {icon} <span font_family='@VAL@' foreground='#ffffff'>+{capacity}%</span>",
        "format-icons": [
            "<span font_family='JetBrainsMono Nerd Font'>▮<span color='#3c3d40'>▮▮▮▮▮▮▮▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮<span color='#3c3d40'>▮▮▮▮▮▮▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮<span color='#3c3d40'>▮▮▮▮▮▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮▮<span color='#3c3d40'>▮▮▮▮▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮▮▮<span color='#3c3d40'>▮▮▮▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮▮▮▮<span color='#3c3d40'>▮▮▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮▮▮▮▮<span color='#3c3d40'>▮▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮▮▮▮▮▮<span color='#3c3d40'>▮▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮▮▮▮▮▮▮<span color='#3c3d40'>▮</span></span>",
            "<span font_family='JetBrainsMono Nerd Font'>▮▮▮▮▮▮▮▮▮▮</span>"
        ],
        "states": { "warning": 30, "critical": 15 },
        "tooltip-format": "Battery {capacity}%  {timeTo}"
    },
    "tray": {
        "spacing": 8
    }
}
